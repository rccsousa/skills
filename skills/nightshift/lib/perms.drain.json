{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit --amend:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase --abort:*)",
      "Bash(rm -rf /:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)",
      "Bash(npm publish:*)",
      "Bash(mix hex.publish:*)",
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Edit(.claude/**)",
      "Edit(**/CLAUDE.md)",
      "Edit(.github/**)"
    ]
  }
}
